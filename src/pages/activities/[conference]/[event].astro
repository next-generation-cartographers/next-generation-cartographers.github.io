---
import Layout from "../../../layouts/Layout.astro";
import Card from "../../../components/Card.astro";
import { getCollection, render } from "astro:content";
import { getEventDuration } from "../../../lib/getEventDuration";

export async function getStaticPaths() {
  const events = await getCollection("events");
  const conferences = await getCollection("conferences");

  return conferences.flatMap((conference) => {
    const conferenceEvents = events.filter(
      (e) => e.id.startsWith(conference.id + "/") && e.draft !== true,
    );
    return conferenceEvents.map((event) => ({
      params: {
        conference: conference.id,
        event: event.id.split("/")[1],
      },
      props: { event, conference },
    }));
  });
}

const { event, conference } = Astro.props;
const { Content } = await render(event);
---

<Layout>
  <div class="feature">
    <Card
      decoration={`"${event.data.type.at(0)}"`}
      style={{ marginBottom: "var(--spacing-lg)" }}
    >
      <div>
        <h2 id={event.id}>{event.data.title}</h2>
        <div>
          <span class="monospace">Datetime</span>
          <strong>
            {
              event.data.dateTime
                ? getEventDuration(
                    event.data.dateTime,
                    conference.data.timezone,
                  )
                : "tba"
            }</strong
          >
        </div>
        <div>
          <span class="monospace">Type</span>
          <strong>{event.data.type}</strong>
        </div>
      </div>
    </Card>
  </div>

  <Content />
</Layout>
