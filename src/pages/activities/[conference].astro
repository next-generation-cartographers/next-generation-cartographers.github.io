---
import Layout from "../../layouts/Layout.astro";

import { getCollection, render } from "astro:content";
import Card from "../../components/Card.astro";
import { getEventDuration } from "../../lib/getEventDuration";

const { conference } = Astro.props;

export async function getStaticPaths() {
  const conferences = await getCollection("conferences");
  return conferences.map((conference) => ({
    params: { conference: conference.id },
    props: { conference },
  }));
}

const events = await getCollection(
  "events",
  (event) => event.id.startsWith(conference.id) && event.data.draft !== true,
);

const { Content } = await render(conference);
---

<Layout>
  <h1 id="next-generation-cartographers">{conference.data.name} activities</h1>
  <Content />

  <div class="grid">
    {
      events
        .toSorted((a, b) => {
          const getTime = (d: (typeof events)[number]) =>
            !d.data.dateTime ? 0 : new Date(d.data.dateTime.start).getTime();
          return getTime(a) - getTime(b);
        })
        .map((event) => {
          return (
            <a
              href={`/activities/${event.id}`}
              style={{ textDecoration: "none" }}
            >
              <Card isInteractive decoration={`"${event.data.type.at(0)}"`}>
                <div>
                  <h2 id={event.id}>{event.data.title}</h2>
                  <div>
                    <span class="monospace">Datetime</span>
                    <strong>
                      {event.data.dateTime
                        ? getEventDuration(
                            event.data.dateTime,
                            conference.data.timezone,
                          )
                        : "tba"}
                    </strong>
                  </div>
                  <div>
                    <span class="monospace">Type</span>
                    <strong>{event.data.type}</strong>
                  </div>
                </div>
              </Card>
            </a>
          );
        })
    }
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    gap: var(--spacing);
    grid-template-columns: 1fr;
    padding-top: var(--spacing-lg);

    > a {
      text-decoration: none;
      color: inherit;
      display: flex;
    }
  }
  @media (min-width: 550px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
